/*
========================================================================================
    Config file for defining DSL2 per module options and publishing paths
========================================================================================
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'PURGEDUPS_SPLITFA' {
        publishDir = [
            path: { "${params.outdir}/purge_dups/splitfa" },
            mode: params.publish_dir_mode,
            pattern: '*.split.fasta.gz'
        ]
    }

    withName: 'MINIMAP2_READS' {
        ext.args = '-x map-hifi'
        publishDir = [
            path: { "${params.outdir}/purge_dups/alignments" },
            mode: params.publish_dir_mode,
            pattern: '*.paf.gz',
            enabled: false
        ]
    }

    withName: 'MINIMAP2_SELF' {
        ext.args = '-x asm5 -DP'
        publishDir = [
            path: { "${params.outdir}/purge_dups/self_alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.paf.gz',
            enabled: false
        ]
    }

    withName: 'PURGEDUPS_PBCSTAT' {
        publishDir = [
            path: { "${params.outdir}/purge_dups/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.{stat,cov}'
        ]
    }

    withName: 'PURGEDUPS_CALCUTS' {
        publishDir = [
            path: { "${params.outdir}/purge_dups/cutoffs" },
            mode: params.publish_dir_mode,
            pattern: '*.{cutoffs,log}'
        ]
    }

    withName: 'PURGEDUPS_PURGEDUPS' {
        ext.args = '-2'
        publishDir = [
            path: { "${params.outdir}/purge_dups/duplicates" },
            mode: params.publish_dir_mode,
            pattern: '*.{bed,log}'
        ]
    }

    withName: 'PURGEDUPS_GETSEQS' {
        ext.args = '-e'  // Only remove duplications at contig ends
        publishDir = [
            path: { "${params.outdir}/purge_dups/purged_sequences" },
            mode: params.publish_dir_mode,
            pattern: '*.{purged.fa,hap.fa}'
        ]
    }
}
